{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run C# project in external terminal",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build C# project",
      "program": "${workspaceFolder}/MyFirstC#Project/bin/Debug/net10.0/MyFirstC#Project.dll",
      "cwd": "${workspaceFolder}/MyFirstC#Project",
      "console": "externalTerminal",
      "stopAtEntry": false,
      "justMyCode": true
    }
  ]
}